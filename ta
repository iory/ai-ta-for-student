  local info
  info=$(curl -fsS -m 15 "$AITA_BASE_URL/key/info" -H "Authorization: Bearer $AITA_KEY") \
    || die "利用額を取得できませんでした ($AITA_BASE_URL/key/info)"
  python3 -c '
import json, sys
i = json.load(sys.stdin)["info"]
spend = i.get("spend") or 0.0
budget = i.get("max_budget")
period = i.get("budget_duration") or ""
reset = i.get("budget_reset_at") or "-"
try:
    from datetime import datetime
    reset = datetime.fromisoformat(reset).astimezone().strftime("%m/%d %H:%M")
except ValueError:
    pass
expires = i.get("expires") or "なし"
line = f"使用額: ${spend:.4f}"
if budget is not None:
