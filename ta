#!/usr/bin/env bash
# ta -- 知能ロボット行動プログラミング演習 AI TA (Claude Code via the course gateway)
#
#   ta                    AI TA と対話を始める
#   ta "質問"             質問を付けて始める
#   ta --continue         直前の会話の続きから (ta --resume で一覧から選ぶ)
#   ta fix [メモ]         直前のエラー情報 (コマンド/出力/画面/ROSログ/環境) を集めて相談
#   ta run <cmd ...>      出力を記録しながらコマンドを実行 (失敗したら ta fix で相談)
#   ta call [メモ]        人間の TA・先生を呼ぶ (エラー情報を添付してダッシュボードに通知)
#   ta review <file.py>   実機に出す前のチェック項目に照らしてコードを見てもらう
#   ta context            ta fix が送る情報を表示だけする (送信しない)
#   ta usage              今日の利用額と上限，カメラ画像 AI の同意
#   ta doctor             サーバー接続・キー・資料の場所を確認
#   ta login              GitHub でログインして自分のキーを設定 (再実行で発行し直し)
#   ta setup <keyfile>    配布されたキーファイルを設定
#   ta version            入っている版 (更新はインストールのコマンドをもう一度)
#   ta uninstall [-y]     AI TA を消す (~/.bashrc の行，Python のフック，キー，ta 本体)
set -euo pipefail

readonly PROG=ta
readonly AITA_CONFIG_DIR=${AITA_CONFIG_DIR:-$HOME/.config/ai-ta}
readonly AITA_SHARE_DIR=${AITA_SHARE_DIR:-$HOME/.local/share/ai-ta}
readonly AITA_CACHE_DIR=${AITA_CACHE_DIR:-$HOME/.cache/ai-ta}
readonly AITA_ENV_FILE=$AITA_CONFIG_DIR/env
# Where `ta login` asks for a key when no key file is set up yet.
readonly AITA_DEFAULT_SERVER=${AITA_DEFAULT_SERVER:-https://jsk-aita.japaneast.cloudapp.azure.com}
readonly AITA_MODEL=${AITA_MODEL:-ta-main}
readonly AITA_FAST_MODEL=${AITA_FAST_MODEL:-ta-fast}
# The context window Claude Code works within for ta-main (it compacts the
# conversation there). Claude Code does not know the gateway alias "ta-main":
# it warns 'Model "ta-main" isn't recognized · context assumed to be 1m tokens'
# at every start (2.1.323). CLAUDE_CODE_MAX_CONTEXT_TOKENS is its documented
# setting for a gateway model's window, and with it the warning is gone
# (https://code.claude.com/docs/en/model-config#correct-the-window-for-a-gateway-or-custom-model-id).
# 200k, not the model's 922k input limit: GPT-6.1 Terra prices a whole request
# with more than 272K input tokens at 2x input / 1.5x output
# (https://developers.openai.com/api/docs/models/gpt-6.1-terra), so sessions
# compact before they get there.
readonly AITA_MAX_CONTEXT_TOKENS=${AITA_MAX_CONTEXT_TOKENS:-200000}
# How much of each source goes into `ta fix` (lines).
readonly CTX_RUN_LINES=${AITA_CTX_RUN_LINES:-200}
readonly CTX_PANE_LINES=${AITA_CTX_PANE_LINES:-150}
readonly CTX_OTHER_PANE_LINES=${AITA_CTX_OTHER_PANE_LINES:-60}
# All tmux/byobu panes together (characters, like CTX_MAX_BYTES): panes past
# it are only listed, so the ROS log and environment after them still fit.
readonly CTX_PANES_MAX_BYTES=${AITA_CTX_PANES_MAX_BYTES:-30000}
readonly CTX_ROSLOG_LINES=${AITA_CTX_ROSLOG_LINES:-80}
readonly CTX_PYERR_LINES=${AITA_CTX_PYERR_LINES:-80}
readonly CTX_MAX_AGE_MIN=${AITA_CTX_MAX_AGE_MIN:-30}
readonly CTX_MAX_BYTES=${AITA_CTX_MAX_BYTES:-60000}
readonly CTX_ROBOT_STATE_S=${AITA_CTX_ROBOT_STATE_S:-3}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
info() { printf '\e[36m[ai-ta]\e[0m %s\n' "$*" >&2; }

load_env() {
  [[ -f $AITA_ENV_FILE ]] || die "キーが未設定です。ta login で GitHub にログインして設定してください"
  # shellcheck disable=SC1090
  source "$AITA_ENV_FILE"
  [[ -n ${AITA_BASE_URL:-} && -n ${AITA_KEY:-} ]] || die "$AITA_ENV_FILE に AITA_BASE_URL / AITA_KEY がありません"
}

# Course docs: explicit AITA_DOCS, else the usual clone locations.
find_docs() {
  local d
  for d in "${AITA_DOCS:-}" \
           "$HOME/ros2_ws/src/robot-programming/docs" \
           "$HOME/catkin_ws/src/robot-programming/docs" \
           "$HOME/robot-programming/docs"; do
    # Claude Code checks --add-dir against the real path: a symlinked
    # ~/ros2_ws left every Read of the docs refused.
    [[ -n $d && -f $d/index.md ]] && { realpath "$d"; return 0; }
  done
  return 1
}

# Mask anything that looks like a credential before it leaves the machine.
redact() {
  sed -E \
    -e 's/\x1b\[[0-9;?]*[ -\/]*[@-~]//g' -e 's/\x1b\][^\x07]*\x07//g' -e 's/\r$//' \
    -e 's/(sk-[A-Za-z0-9_-]{8})[A-Za-z0-9_-]+/\1…[redacted]/g' \
    -e 's/(AIza)[A-Za-z0-9_-]{20,}/\1…[redacted]/g' \
    -e 's/((api[_-]?key|token|secret|password|passwd|AITA_KEY)["'"'"' ]*[:=] *["'"'"']?)[^ "'"'"']+/\1[redacted]/Ig'
}

# Ages in minutes of a file.
age_min() { echo $(( ( $(date +%s) - $(stat -c %Y "$1") ) / 60 )); }

section() { printf '\n### %s\n```\n' "$1"; cat; printf '```\n'; }

# One line per `ros2 launch` / `gz sim` of this user: pid, age, ROS_DOMAIN_ID,
# GZ_PARTITION, command. "ORPHAN?" marks a gz server with no launch parent.
running_robot_procs() {
  local pid etimes args env dom part parent mark
  while read -r pid etimes args; do
    env=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null) || continue
    dom=$(sed -n 's/^ROS_DOMAIN_ID=//p' <<< "$env"); part=$(sed -n 's/^GZ_PARTITION=//p' <<< "$env")
    mark=""
    if [[ $args == "gz sim"* ]]; then
      parent=$(ps -o args= -p "$(ps -o ppid= -p "$pid" | tr -d ' ')" 2>/dev/null)
      [[ $parent == *"ros2 launch"* || $parent == *"gz sim"* || $parent == *ruby* ]] || mark="  ORPHAN? (親の launch が無い)"
    fi
    printf 'pid=%s 起動%d分前 domain=%s partition=%s  %s%s\n' "$pid" "$((etimes / 60))" \
      "${dom:-0}" "${part:-}" "${args:0:110}" "$mark"
  done < <(ps -u "$(id -u)" -o pid=,etimes=,args= | grep -E 'ros2 launch|gz sim' | grep -vE 'grep|ruby ' || true)
}

# Lines that mark a pane worth reading first.
readonly PANE_ERROR_RE='Traceback|Error|\[ERROR\]'

# Every pane of every window of this tmux / byobu session: students run ipython
# or their program in one window and type `ta fix` in another, so the
# traceback is rarely in ta's own window. ta's own pane ($TMUX_PANE, set by
# tmux / byobu-tmux in every pane; not the session's current window, which
# another client may be looking at) gets CTX_PANE_LINES, the others
# CTX_OTHER_PANE_LINES. Panes showing an error come first; panes past
# CTX_PANES_MAX_BYTES are only named.
collect_panes() {
  local cur pid widx pidx pcmd wname n text label used=0
  local -a first=() rest=() skipped=()
  local -A texts=() labels=()
  cur=${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}
  while IFS=$'\t' read -r pid widx pidx pcmd wname; do
    if [[ $pid == "$cur" ]]; then n=$CTX_PANE_LINES; else n=$CTX_OTHER_PANE_LINES; fi
    text=$(tmux capture-pane -p -J -t "$pid" -S "-$n" 2>/dev/null \
      | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' || true)
    [[ -n $text ]] || continue
    label="tmux/byobu 画面 window $widx ($wname) pane $pidx [$pcmd]"
    [[ $pid == "$cur" ]] && label+=" ← ta を実行した画面"
    texts[$pid]=$text
    # An AI TA session (claude) quotes errors in its answers: not a new error.
    if [[ $pcmd != claude ]] && grep -qE "$PANE_ERROR_RE" <<< "$text"; then
      label+=" ← エラーらしき行あり"
      if [[ $pid == "$cur" ]]; then first=("$pid" "${first[@]}"); else first+=("$pid"); fi
    elif [[ $pid == "$cur" ]]; then
      rest=("$pid" "${rest[@]}")
    else
      rest+=("$pid")
    fi
    labels[$pid]=$label
  done < <(tmux list-panes -s -t "$cur" \
             -F $'#{pane_id}\t#{window_index}\t#{pane_index}\t#{pane_current_command}\t#{window_name}')
  for pid in "${first[@]}" "${rest[@]}"; do
    # ta's own pane always goes in; it is at most CTX_PANE_LINES lines.
    if [[ $pid != "$cur" ]] && (( used + ${#texts[$pid]} > CTX_PANES_MAX_BYTES )); then
      skipped+=("${labels[$pid]}")
      continue
    fi
    used=$(( used + ${#texts[$pid]} ))
    section "${labels[$pid]}" <<< "${texts[$pid]}"
  done
  if (( ${#skipped[@]} )); then
    printf '%s\n' "${skipped[@]}" | section "長すぎるため省いた tmux/byobu 画面"
  fi
}

collect_context() {
  local f ec ts cwd cmd
  echo "<ta-context>"
  echo "収集時刻: $(date '+%F %T')  (ta fix が自動収集)"

  f=$AITA_CACHE_DIR/last_failed
  if [[ -f $f && $(age_min "$f") -le $CTX_MAX_AGE_MIN ]]; then
    IFS=$'\t' read -r ec ts cwd cmd < "$f"
    printf '\n### 直前に失敗したコマンド (%s分前)\n```\n$ %s\n(exit %s, cwd %s)\n```\n' \
      "$(age_min "$f")" "$cmd" "$ec" "$cwd"
  fi

  f=$AITA_CACHE_DIR/runs/latest.log
  if [[ -f $f && $(age_min "$f") -le $CTX_MAX_AGE_MIN ]]; then
    local meta=$AITA_CACHE_DIR/runs/latest.meta
    [[ -f $meta ]] && sed 's/^/# /' "$meta" | section "ta run の記録 (メタ情報)"
    tail -n "$CTX_RUN_LINES" "$f" | section "ta run の出力 (末尾 $CTX_RUN_LINES 行)"
  fi

  if [[ -n ${TMUX:-} ]] && command -v tmux >/dev/null; then
    collect_panes
  fi

  local roslog
  roslog=$(ls -td "$HOME"/.ros/log/*/ 2>/dev/null | head -1 || true)
  if [[ -n $roslog && -f $roslog/launch.log && $(age_min "$roslog/launch.log") -le $CTX_MAX_AGE_MIN ]]; then
    tail -n "$CTX_ROSLOG_LINES" "$roslog/launch.log" \
      | section "最新の ros2 launch ログ ${roslog/#$HOME/\~}launch.log ($(age_min "$roslog/launch.log")分前)"
  fi

  # Uncaught Python exceptions recorded by aita_pyhook (any terminal, ros2 run nodes too).
  f=$AITA_CACHE_DIR/py_errors/latest.txt
  if [[ -f $f && $(age_min "$f") -le $CTX_MAX_AGE_MIN ]]; then
    tail -n "$CTX_PYERR_LINES" "$f" | section "最新の Python 例外 Traceback ($(age_min "$f")分前)"
  fi

  # Running robot launches / Gazebo servers of this user: two at once, or a
  # Gazebo left over after its launch ended, explain many "it doesn't move".
  local procs
  procs=$(running_robot_procs)
  if [[ -n $procs ]]; then
    section "動いている ros2 launch / Gazebo (このユーザー)" <<< "$procs"
  fi

  # Servos that do not answer, faults, diagnostics: what RViz shows as red
  # links, as text. Only with a robot up -- otherwise it would wait for nothing.
  if [[ -n $procs ]] && command -v ros2 >/dev/null; then
    timeout 10 python3 "$AITA_SHARE_DIR/aita_robot_state.py" --seconds "$CTX_ROBOT_STATE_S" 2>&1 \
      | grep -v '^\[' | section "ロボットの状態 (サーボの応答・トルク・diagnostics, ${CTX_ROBOT_STATE_S} 秒間)"
  fi

  {
    echo "os: $(lsb_release -ds 2>/dev/null || uname -sr)"
    echo "cwd: ${PWD/#$HOME/\~}"
    echo "display: DISPLAY=${DISPLAY:-<unset>} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<unset>} (unset なら画面なし: Gazebo は gui:=false, rviz 不可)"
    echo "shell: $(ps -o comm= -p "$PPID" 2>/dev/null || echo "${SHELL##*/}")  python3: $(python3 --version 2>&1 | cut -d' ' -f2)"
    for v in ROS_DISTRO ROS_VERSION ROS_DOMAIN_ID ROS_AUTOMATIC_DISCOVERY_RANGE ROS_LOCALHOST_ONLY RMW_IMPLEMENTATION ROS_MASTER_URI; do
      printf '%s=%s\n' "$v" "${!v:-<unset>}"
    done
    echo "AMENT_PREFIX_PATH (sourced workspaces):"
    tr ':' '\n' <<< "${AMENT_PREFIX_PATH:-}" | sed -E 's|/install/[^/]+$|/install/…|' | sort -u | sed 's/^/  /' | head -15
    echo "groups: $(id -nG)"
    echo "serial devices: $(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ' ' || true)"
    if git -C "$PWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "git: $(git -C "$PWD" rev-parse --show-toplevel | sed "s|^$HOME|~|") @ $(git -C "$PWD" rev-parse --abbrev-ref HEAD) ($(git -C "$PWD" status --porcelain | wc -l) changed files)"
    fi
  } | section "環境"
  echo "</ta-context>"
}

# A key exported in the shell (e.g. `export AITA_KEY=...` in ~/.bashrc) wins
# over ~/.config/ai-ta/env for the students' own programs (jedy_skrobot's VLM
# reads the environment first); `ta` itself always uses the file. Taken before
# load_env replaces it. Never printed.
readonly SHELL_AITA_KEY=${AITA_KEY:-}

# For a 401 in the context: say whether an exported AITA_KEY is in play, so the
# TA does not just answer "ta login again" (a new key in the file does not
# help a program that reads the old exported one).
key_override_note() {
  [[ -n $SHELL_AITA_KEY ]] || return 0
  local file_key env_file=${AITA_ENV_FILE/#$HOME/\~} same advice
  file_key=$(sed -nE "s/^(export +)?AITA_KEY=['\"]?([^'\"]*)['\"]?\$/\2/p" "$AITA_ENV_FILE" 2>/dev/null | tail -1)
  if [[ -n $file_key && $file_key == "$SHELL_AITA_KEY" ]]; then
    same="$env_file のキーと同じ"
    advice="キーは同じなので，401 ならキー自体が無効 (ta login で発行し直すと前のキーは無効になる)。ta login をやり直し，そのあと開いているターミナルでは 'unset AITA_KEY' する (export された古い値が残るため)。"
  else
    same="$env_file のキーと違う"
    advice="401 の原因は，この古いキーの環境変数の可能性が高い: 'unset AITA_KEY' してから実行し直し，~/.bashrc などの 'export AITA_KEY=' の行を消す (ta login をやり直してもこの環境変数は変わらない)。"
  fi
  section "キーの設定 (401 / 認証エラーがあるため)" <<EOF
環境変数 AITA_KEY がこのシェルで設定されている (export されている): $same。
自作プログラム (jedy_skrobot の VLM など) は $env_file より環境変数を優先する。ta 自身はファイルのキーを使う。
$advice
EOF
}

bounded_context() {
  local out
  out=$(collect_context | redact)
  if grep -qiE '(http|status|code|error)[^0-9]{0,12}401\b|unauthori[sz]ed|authentication_error|invalid api key' <<< "$out"; then
    out="${out%</ta-context>}$(key_override_note)
</ta-context>"
  fi
  if (( ${#out} > CTX_MAX_BYTES )); then
    out="${out:0:$CTX_MAX_BYTES}
…(長すぎるため切り詰めました)
</ta-context>"
  fi
  printf '%s\n' "$out"
}

# Words that mean "a person or the hardware may be at risk right now". The AI
# answer takes a minute or more; the first steps must not wait for it.
readonly SAFETY_RE='煙|けむり|焦げ|こげ|発火|火花|燃え|発熱|熱く|熱い|異音|異臭|ガリガリ|カチカチ|暴走|止まらない|挟ま|はさま|怪我|けが|ケガ|出血|やけど|火傷|感電|倒れ|転倒|転落|落下|落ち'
# Arms dropping is what servo_off / the power switch does (the docs say so):
# 「servo_off したら腕が落ちた」 is not an emergency. Taken out of the text
# before SAFETY_RE; anything else that fell (ロボットが机から落ちた), and the
# other words in the same message, still count.
readonly ARM_DROP_RE='(腕|うで|アーム|手先|ハンド|グリッパ)(が|は|も)?(ゆっくり|すとんと|ストンと|だらんと|下に|下へ)?落ち'

safety_first() {
  local text="$*"
  while [[ $text =~ $ARM_DROP_RE ]]; do text=${text/"${BASH_REMATCH[0]}"/ }; done
  [[ $text =~ $SAFETY_RE ]] || return 0
  printf '\e[1;31m%s\e[0m\n' \
    "[ai-ta] 安全に関わる内容に見えます。AI の回答を待たずに，まず:" \
    "  1. 動いているプログラムを Ctrl-C で止める" \
    "  2. 実機ならロボット背面のスイッチでサーボ電源を切る (腕が落ちるので手や物を離す)" \
    "  3. 煙・焦げ臭さ・発熱があれば触らず，近くの TA / 先生に直接声をかける" \
    "  4. ta call \"机の番号と状況\" で TA を呼ぶ" >&2
}

launch_claude() {
  load_env
  command -v claude >/dev/null || die "claude が見つかりません。install.sh を実行してください"
  # Claude Code retries an unreachable server for many minutes without a word,
  # which a student cannot tell from "thinking". Ask the gateway first.
  if ! curl -s -o /dev/null -m "${AITA_CONNECT_TIMEOUT:-8}" "$AITA_BASE_URL/health/liveliness"; then
    die "AI TA サーバー ($AITA_BASE_URL) に接続できません。ネットワーク接続を確認し，'ta doctor' を実行してください。急ぐときは手を挙げて TA を呼んでください"
  fi
  # A spent budget otherwise surfaces as a raw "API Error: 422 Budget has been
  # exceeded!" in English; say what it means and what to do instead.
  local spent
  spent=$(curl -s -m 10 "$AITA_BASE_URL/key/info" -H "Authorization: Bearer $AITA_KEY" | python3 -c '
import json, sys
try:
    i = json.load(sys.stdin)["info"]
except Exception:
    sys.exit(0)   # cannot tell: let the request itself report
b = i.get("max_budget")
if b is not None and (i.get("spend") or 0.0) >= b:
    print(i.get("budget_reset_at") or "")
' 2>/dev/null || true)
  if [[ -n $spent ]]; then
    die "今日の AI TA の利用枠を使い切りました (次に使えるのは $(date -d "$spent" '+%m/%d %H:%M' 2>/dev/null || echo "$spent") から)。資料を探すか，'ta call \"机番号と内容\"' で TA を呼んでください"
  fi
  if [[ ! -f $AITA_CONFIG_DIR/.notice_shown ]]; then
    info "お知らせ: AI TA への質問と回答は記録され，教員・TA がダッシュボードで確認します（演習の改善と，人の助けが必要な人を見つけるため）。"
    info "パスワードや個人情報は書かないでください。人を呼びたいときは 'ta call'。"
    touch "$AITA_CONFIG_DIR/.notice_shown"
  fi
  local docs; docs=$(find_docs || true)
  # Claude Code's built-in skills (code review, API reference, ...) only cost
  # time and money here: the TA answers from the course docs.
  local args=(--append-system-prompt-file "$AITA_SHARE_DIR/ta-prompt.md" --disallowed-tools Skill)
  # Extra Claude Code flags, e.g. AITA_CLAUDE_ARGS="-p --continue" for
  # scripted / non-interactive use (tests, mock students).
  local extra=()
  [[ -n ${AITA_CLAUDE_ARGS:-} ]] && read -r -a extra <<< "$AITA_CLAUDE_ARGS"
  args+=("${extra[@]}")
  if [[ -n $docs ]]; then
    args+=(--add-dir "$docs" --append-system-prompt "AITA_DOCS=$docs (演習資料。tips/ に Tips 集)")
  else
    info "演習資料 (robot-programming/docs) が見つかりません。AITA_DOCS=<path> で指定できます"
  fi
  # Our gateway, our models, nothing else: no personal Anthropic credentials,
  # and a config dir separate from any personal Claude Code setup.
  (
    unset ANTHROPIC_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
    export CLAUDE_CONFIG_DIR="$AITA_CONFIG_DIR/claude" \
      ANTHROPIC_BASE_URL="$AITA_BASE_URL" \
      ANTHROPIC_AUTH_TOKEN="$AITA_KEY" \
      ANTHROPIC_MODEL="$AITA_MODEL" \
      ANTHROPIC_DEFAULT_OPUS_MODEL="$AITA_MODEL" \
      ANTHROPIC_DEFAULT_SONNET_MODEL="$AITA_MODEL" \
      ANTHROPIC_DEFAULT_HAIKU_MODEL="$AITA_FAST_MODEL" \
      CLAUDE_CODE_SUBAGENT_MODEL="$AITA_MODEL" \
      CLAUDE_CODE_MAX_CONTEXT_TOKENS="$AITA_MAX_CONTEXT_TOKENS" \
      CLAUDE_CODE_RESUME_HINT_COMMAND="$PROG" \
      CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
      DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 DISABLE_AUTOUPDATER=1
    run_claude "${args[@]}" "$@"
  )
}

# In print mode (-p) the answer only ever exists on the terminal, so keep a
# copy: `cat ~/.cache/ai-ta/last_answer.md` after a `clear`. Interactive
# sessions must keep the TTY (no pipe) and have their own history (/resume).
run_claude() {
  local a
  for a in "$@"; do
    if [[ $a == -p || $a == --print ]]; then
      mkdir -p "$AITA_CACHE_DIR"
      # Print mode also writes a "[claude-code:unrecognized_model]" line for
      # the gateway alias. The documented way to stop it (a modelOverrides
      # entry) would make Claude Code treat ta-main as some Claude model, so
      # drop the line here instead.
      claude "$@" 2> >(grep -vE "doesn't recognize the model|unrecognized_model" >&2) \
        | tee "$AITA_CACHE_DIR/last_answer.md"
      return "${PIPESTATUS[0]}"
    fi
  done
  local ec=0
  claude "$@" || ec=$?
  # On exit Claude Code prints "<cmd> --resume <id>". With
  # CLAUDE_CODE_RESUME_HINT_COMMAND=ta (launch_claude; Claude Code 2.1.323+,
  # https://code.claude.com/docs/en/env-vars) that line already says
  # "ta --resume <id>", and a second, different hint here only confused
  # students. Older Claude Code says "claude --resume <id>", which starts
  # outside the AI TA (no course gateway, no TA prompt or settings): point at it.
  if ! claude_names_ta_in_resume_hint; then
    info "↑ の 'claude --resume …' ではなく 'ta --continue' (直前の会話) または 'ta --resume' (一覧から選ぶ，↑ の ID も付けられる) で再開してください"
  fi
  return "$ec"
}

# Whether this Claude Code honours CLAUDE_CODE_RESUME_HINT_COMMAND (2.1.323+).
claude_names_ta_in_resume_hint() {
  local v
  v=$(claude --version 2>/dev/null | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+' || true)
  [[ -n $v ]] || return 1
  [[ $(printf '%s\n' 2.1.323 "$v" | sort -V | head -1) == 2.1.323 ]]
}

cmd_call() {
  load_env
  [[ -n ${AITA_HELP_URL:-} ]] || die "キーファイルに AITA_HELP_URL がありません。新しく配布されたキーで ta setup してください"
  local msg=${*:-}
  if [[ -z $msg ]]; then
    read -r -p "どんなことで困っていますか？（机の番号・場所もあれば）: " msg
  fi
  local ctx; ctx=$(bounded_context)
  local body
  body=$(AITA_MSG=$msg AITA_CTX=$ctx python3 -c 'import json, os; print(json.dumps({"message": os.environ["AITA_MSG"], "context": os.environ["AITA_CTX"]}, ensure_ascii=False))')
  local resp code
  resp=$(curl -sS -m 15 -w '\n%{http_code}' -X POST "$AITA_HELP_URL/api/call" \
    -H "Authorization: Bearer $AITA_KEY" -H 'Content-Type: application/json' --data-binary "$body") \
    || die "呼び出しを送れませんでした (サーバーに接続できません)。手を挙げて TA を呼んでください"
  code=${resp##*$'\n'}; resp=${resp%$'\n'*}
  if [[ $code == 429 ]]; then
    info "$(python3 -c 'import json, sys; print(json.load(sys.stdin).get("detail", ""))' <<< "$resp")"
    return 0
  fi
  [[ $code == 200 ]] || die "呼び出しに失敗しました (HTTP $code)。手を挙げて TA を呼んでください"
  local ahead
  ahead=$(python3 -c 'import json, sys; print(json.load(sys.stdin).get("ahead", "?"))' <<< "$resp")
  info "TA・先生に通知しました（エラー情報も添付）。あなたより前に ${ahead} 件待っています。"
}

cmd_fix() {
  local note=${*:-直前のエラーを解決したい。}
  safety_first "$note"
  local ctx; ctx=$(bounded_context)
  mkdir -p "$AITA_CACHE_DIR"
  printf '%s\n' "$ctx" > "$AITA_CACHE_DIR/last_context.md"
  info "エラー情報を収集しました (${#ctx} 文字, 内容: ta context / $AITA_CACHE_DIR/last_context.md)"
  launch_claude "$note

$ctx"
}

# Before the real robot: the AI goes through the checklist in the docs and
# points at lines; it does not edit the file, so the student makes the changes.
# Items code cannot show (people nearby, someone at the power switch) are left
# for the student to confirm.
cmd_review() {
  [[ $# -ge 1 ]] || die "使い方: ta review <ファイル.py>"
  local file; file=$(realpath -e "$1" 2>/dev/null) || die "ファイルがありません: $1"
  launch_claude "ta review: 実機で動かす前のチェックをお願いします。対象: $file

資料 robot-programming-2-2026.md の「実機に出す前のチェック」の各項目について，このファイルの該当行（file:line）と，問題があればその理由・直し方の方針を書いてください。
- ファイルは書き換えないでください（直すのは学生）。
- 該当行は $(basename "$file"):42 のようにそのまま書き，Markdown のリンクにしないでください。
- チェック項目に反するもの（直してから実機へ）と，チェック項目に無い改善案（任意）を分けて書いてください。資料の「プログラムの形」やコード例と同じ書き方は指摘しないでください。
- 距離画像・物の位置 (ri.depth_image / ri.detection_position / ri.pixel_position) を使っていれば，資料「実機とシミュレータの違い」の D405 の測れる範囲 (遠いと nan / None) に頼っていないかも確かめてください。
- コードから分かる項目に問題がなければ，そう書いてください。
- コードから分からない項目（周りに人や机が無いか，止まらないときに電源を切れる人がそばにいるか）は，学生に確かめるよう書いてください。"
}

cmd_run() {
  (( $# )) || die "使い方: ta run <command ...>"
  command -v script >/dev/null || die "script (util-linux) が必要です"
  local dir=$AITA_CACHE_DIR/runs ts log cmd ec
  mkdir -p "$dir"
  ts=$(date +%Y%m%d-%H%M%S)
  log=$dir/$ts.log
  cmd=$(printf '%q ' "$@")
  info "記録中: $log"
  set +e
  script -q -e -f -c "$cmd" "$log"
  ec=$?
  set -e
  printf 'command: %s\ncwd: %s\nexit: %s\nstarted: %s\n' "$cmd" "$PWD" "$ec" "$ts" > "$dir/$ts.meta"
  ln -sfn "$ts.log" "$dir/latest.log"
  ln -sfn "$ts.meta" "$dir/latest.meta"
  # Keep the newest 50 runs.
  ls -t "$dir"/*.log 2>/dev/null | tail -n +51 | while read -r old; do rm -f "$old" "${old%.log}.meta"; done
  # Ctrl-C / timeout are not failures: same rule as __aita_interrupted in
  # ta-hook.bash (130, 148, 124; 2 and 254 from ros2).
  if (( ec == 130 || ec == 148 || ec == 124 )) || { (( ec == 2 || ec == 254 )) && [[ $1 == ros2 ]]; }; then
    return "$ec"
  fi
  if (( ec != 0 )); then
    printf '%s\t%s\t%s\t%s\n' "$ec" "$(date +%s)" "$PWD" "$cmd" > "$AITA_CACHE_DIR/last_failed"
    info "exit $ec — 'ta fix' で AI TA に相談できます"
  fi
  return "$ec"
}

# One line on the camera-image VLM (vlm-gemini / vlm-er) from /key/info JSON on
# stdin: whether this key's student agreed at `ta login` (metadata.vlm_consent,
# the version of the text agreed to; the server refuses VLM requests without
# it). The VLM's own daily spend is kept by the server and not shown to keys.
vlm_consent_line() {
  python3 -c '
import json, sys
try:
    m = json.load(sys.stdin)["info"].get("metadata") or {}
except (ValueError, KeyError, AttributeError):
    sys.exit(1)
if m.get("vlm_consent"):
    print("同意済み (使える)")
else:
    print("同意していない (使えない。使うときは ta login をやり直して同意する)")
'
}

