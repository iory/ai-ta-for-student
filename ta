ta_version() {
  cat "$AITA_SHARE_DIR/VERSION" 2>/dev/null || echo unknown
}

cmd_doctor() {
  local ok=0 docs
  echo "  ai-ta-for-student $(ta_version)"
  if [[ -f $AITA_ENV_FILE ]]; then
    load_env; echo "✓ キー設定: $AITA_ENV_FILE"
    if [[ -n $SHELL_AITA_KEY && $SHELL_AITA_KEY != "$AITA_KEY" ]]; then
      echo "! 環境変数 AITA_KEY が $AITA_ENV_FILE と違うキーです。自作プログラム (VLM) はそちらを使います: 'unset AITA_KEY' し，~/.bashrc などの export を消す"
    fi
  else echo "✗ キー未設定 (ta login，配られたキーファイルなら ta setup <file>)"; ok=1; fi
  if command -v claude >/dev/null; then echo "✓ claude: $(claude --version 2>/dev/null)"; else echo "✗ claude 未インストール"; ok=1; fi
  if [[ -n ${AITA_KEY:-} ]]; then
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$AITA_BASE_URL/v1/models" -H "Authorization: Bearer $AITA_KEY" || true)
    case $code in
      200) echo "✓ サーバー: $AITA_BASE_URL (認証 OK)"
           local info consent
           if info=$(curl -fsS -m 10 "$AITA_BASE_URL/key/info" -H "Authorization: Bearer $AITA_KEY" 2>/dev/null); then
             if consent=$(vlm_consent_line <<< "$info"); then
               echo "- カメラ画像を AI に送る機能 (vlm-gemini / vlm-er): $consent"
             fi
             save_key_expiry <<< "$info" || true
           fi ;;
      401|403) echo "✗ サーバー: $AITA_BASE_URL キーが無効 (HTTP $code)"; ok=1 ;;
      000) echo "✗ サーバー: $AITA_BASE_URL に接続できません (ネットワーク接続?)"; ok=1 ;;
      *) echo "✗ サーバー: $AITA_BASE_URL HTTP $code"; ok=1 ;;
    esac
  fi
  if docs=$(find_docs); then echo "✓ 演習資料: $docs"; else echo "✗ 演習資料が見つかりません (AITA_DOCS=<.../robot-programming/docs>)"; ok=1; fi
  if declare -F __aita_prompt >/dev/null 2>&1 || grep -q 'ai-ta/ta-hook.bash' "$HOME/.bashrc" 2>/dev/null; then
    echo "✓ bash フック (失敗コマンドの記録) 有効"
  else
    echo "- bash フック未設定 (install.sh で設定されます)"
  fi
  return $ok
}

cmd_login() {
  # GitHub OAuth device flow for the course's OAuth App, then the server swaps
  # the GitHub token for this student's key (roster: student_id <-> GitHub).
  local server=${1:-}
  if [[ -z $server && -f $AITA_ENV_FILE ]]; then
    server=$(sed -n 's/^AITA_BASE_URL=//p' "$AITA_ENV_FILE" | head -1)
  fi
  server=${server:-$AITA_DEFAULT_SERVER}
  mkdir -p "$AITA_CONFIG_DIR"; chmod 700 "$AITA_CONFIG_DIR"
  python3 - "$server" "$AITA_ENV_FILE" <<'PY' || exit 1
import json, os, subprocess, sys, time, urllib.error, urllib.parse, urllib.request

server, env_file = sys.argv[1].rstrip("/"), sys.argv[2]


def request(url, data=None, form=False):
    """POST (JSON or form) or GET; return (status, parsed JSON body)."""
    headers = {"Accept": "application/json"}
    body = None
    if data is not None:
        if form:
            body = urllib.parse.urlencode(data).encode()
        else:
            body = json.dumps(data).encode()
            headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, json.load(resp)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except ValueError:
            return e.code, {}
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"ta: {url} に接続できません ({e})。ネットワーク接続を確認してください")


def fail(status, body):
    detail = body.get("detail") if isinstance(body, dict) else None
    sys.exit(f"ta: {detail or 'エラー'} (HTTP {status})")


status, conf = request(f"{server}/api/login/config")
if status != 200:
    fail(status, conf)
client_id = conf["github_client_id"]
status, dev = request("https://github.com/login/device/code", {"client_id": client_id}, form=True)
if status != 200 or "device_code" not in dev:
    sys.exit(f"ta: GitHub のログインを始められません (HTTP {status} {dev.get('error', '')})")
print(f"\n  1. ブラウザで {dev['verification_uri']} を開く", file=sys.stderr)
print(f"  2. コード  \033[1m{dev['user_code']}\033[0m  を入力して，演習の AI TA を承認する\n", file=sys.stderr)
try:
    subprocess.Popen(["xdg-open", dev["verification_uri"]],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except OSError:
    pass
interval = int(dev.get("interval", 5))
deadline = time.time() + int(dev.get("expires_in", 900))
token = None
print("  承認を待っています (Ctrl-C で中止)...", file=sys.stderr)
while time.time() < deadline:
    time.sleep(interval)
    status, res = request("https://github.com/login/oauth/access_token", {
        "client_id": client_id, "device_code": dev["device_code"],
        "grant_type": "urn:ietf:params:oauth:grant-type:device_code"}, form=True)
    err = res.get("error")
    if "access_token" in res:
        token = res["access_token"]
        break
    if err == "authorization_pending":
        continue
    if err == "slow_down":
        interval = int(res.get("interval", interval + 5))
        continue
    if err == "access_denied":
        sys.exit("ta: GitHub で承認がキャンセルされました")
    sys.exit(f"ta: GitHub のログインに失敗しました ({err or status})")
if token is None:
    sys.exit("ta: 承認の待ち時間が切れました。もう一度 ta login してください")
def ask_consent(text):
    """Show a consent text and ask y/n on the terminal (stdin is this heredoc).

    No terminal, an empty line or "n" = no.
    """
    print("\n" + "-" * 60 + "\n" + text + "\n" + "-" * 60, file=sys.stderr)
    try:
        # Separate read / write handles: "r+" on a tty fails (not seekable).
        with open("/dev/tty") as tty_in, open("/dev/tty", "w") as tty_out:
            while True:
                tty_out.write("同意しますか? [y/n]: ")
                tty_out.flush()
                reply = tty_in.readline().strip().lower()
                if reply in ("y", "yes", "n", "no", ""):
                    return reply in ("y", "yes")
    except OSError:
        print("ta: 端末が無いので「同意しない」として続けます", file=sys.stderr)
        return False


answers = {}
for consent in conf.get("consents") or []:
    agree = ask_consent(consent["text"])
    answers[consent["kind"]] = {"version": consent["version"], "agree": agree}
    if consent.get("required") and not agree:
        break  # the server records the "no" and issues no key
status, res = request(f"{server}/api/login", {"github_token": token, "consents": answers})
if status != 200:
    fail(status, res)
old = os.umask(0o077)
tmp = env_file + ".tmp"
with open(tmp, "w") as f:
    f.write(res["env"])
os.replace(tmp, env_file)
os.umask(old)
what = "発行し直しました (前のキーは無効になりました)" if res.get("replaced_old_key") else "発行しました"
print(f"\033[36m[ai-ta]\033[0m {res['student_id']} {res['name']} (GitHub: {res['github']}) のキーを{what}: {env_file}",
      file=sys.stderr)
if res.get("vlm_asked"):
    state = "使えます" if res.get("vlm") else "使えません (同意しなかったため)"
    print(f"\033[36m[ai-ta]\033[0m カメラ画像を AI に送る機能 (vlm-gemini / vlm-er) は{state}", file=sys.stderr)
PY
  cmd_doctor || true
}

# The key's expiry (epoch seconds) for the bash / Python hooks: past it they do
# nothing, so a student who never runs `ta uninstall` does not get the
# "[ai-ta] exit N" line and the traceback recording for ever after the
# course. stdin: the /key/info JSON. No expiry = no file.
save_key_expiry() {
  local out=$AITA_CONFIG_DIR/expires exp
  exp=$(python3 -c '
import json, sys
from datetime import datetime, timezone
exp = json.load(sys.stdin)["info"].get("expires")
if exp:
    t = datetime.fromisoformat(exp.replace("Z", "+00:00"))
    if t.tzinfo is None:
        t = t.replace(tzinfo=timezone.utc)
    print(int(t.timestamp()))
') || return 1
  if [[ -n $exp ]]; then
    printf '%s\n' "$exp" > "$out.tmp" && mv "$out.tmp" "$out"
  else
    rm -f "$out"
  fi
}

# The lines install.sh adds to ~/.bashrc (exact lines, so a student's own
# lines are never touched).
readonly BASHRC_LINES=(
  '# AI TA: record failed commands for `ta fix`'
  '[ -f ~/.local/share/ai-ta/ta-hook.bash ] && . ~/.local/share/ai-ta/ta-hook.bash'
  'case :$PATH: in *:$HOME/.local/bin:*) ;; *) export PATH=$HOME/.local/bin:$PATH;; esac  # ai-ta: ~/.local/bin'
)

cmd_uninstall() {
  local yes='' claude='' arg reply site
  for arg in "$@"; do
    case $arg in
      -y|--yes) yes=1 ;;
      --claude) claude=1 ;;
      *) die "使い方: ta uninstall [-y] [--claude]" ;;
    esac
  done
  # Claude Code goes too when install.sh installed it (0.2.5+ leaves a mark).
  [[ -f $AITA_SHARE_DIR/installed-claude ]] && claude=1
  site=$(python3 -m site --user-site 2>/dev/null || true)
  local -a paths=("$HOME/.local/bin/ta" "$AITA_SHARE_DIR" "$AITA_CONFIG_DIR" "$AITA_CACHE_DIR")
  [[ -n $site ]] && paths+=("$site/aita_pyhook.py" "$site/aita-pyhook.pth")
  [[ -n $claude ]] && paths+=("$HOME/.local/bin/claude" "$HOME/.local/share/claude")
  echo "AI TA を消します (サーバーにある記録は消えません):"
  echo "  ~/.bashrc に足した ai-ta の行 (元は ~/.bashrc.ai-ta-backup に残す)"
  local p
  for p in "${paths[@]}"; do
    [[ -e $p || -L $p ]] && echo "  ${p/#$HOME/\~}"
  done
  echo "  (キー・AI TA との会話の記録・ta fix 用の記録もこの中に入っている)"
  if [[ -z $yes ]]; then
    read -r -p "消しますか? [y/N]: " reply < /dev/tty || reply=
    [[ $reply == [yY]* ]] || { echo "中止しました"; return 1; }
  fi
  if [[ -f $HOME/.bashrc ]] && grep -qxF -f <(printf '%s\n' "${BASHRC_LINES[@]}") "$HOME/.bashrc"; then
    cp -p "$HOME/.bashrc" "$HOME/.bashrc.ai-ta-backup"
    # Write in place (cat >) so a symlinked ~/.bashrc and its mode stay.
    local kept
    kept=$(grep -vxF -f <(printf '%s\n' "${BASHRC_LINES[@]}") "$HOME/.bashrc" || true)
    printf '%s\n' "$kept" > "$HOME/.bashrc"
    echo "~/.bashrc から ai-ta の行を消しました"
  fi
  [[ -n $site ]] && rm -f "$site"/__pycache__/aita_pyhook.*.pyc
  for p in "${paths[@]}"; do
    rm -rf -- "$p"
  done
  echo "消しました。開いているターミナルでも [ai-ta] の表示はもう出ません。"
  if [[ -z $claude ]] && command -v claude >/dev/null; then
    echo "Claude Code は残しています (AI TA より前から入っていたか，0.2.4 以前で入れたもの)。消すなら: rm -rf ~/.local/bin/claude ~/.local/share/claude"
  fi
  # This script was just deleted; bash keeps reading it from the open file, so
  # end here.
  exit 0
}

cmd_setup() {
  local src=${1:?使い方: ta setup <配布されたキーファイル>}
  [[ -f $src ]] || die "$src がありません"
  grep -q '^AITA_KEY=' "$src" && grep -q '^AITA_BASE_URL=' "$src" || die "$src はキーファイルではないようです"
  mkdir -p "$AITA_CONFIG_DIR"; chmod 700 "$AITA_CONFIG_DIR"
  install -m 600 "$src" "$AITA_ENV_FILE"
  info "設定しました: $AITA_ENV_FILE"
  cmd_doctor || true
}

case ${1:-} in
  fix)      shift; cmd_fix "$@" ;;
  call)     shift; cmd_call "$@" ;;
  run)      shift; cmd_run "$@" ;;
  review)   shift; cmd_review "$@" ;;
  context)  bounded_context ;;
  usage)    cmd_usage ;;
  doctor)   cmd_doctor ;;
  setup)    shift; cmd_setup "$@" ;;
  login)    shift; cmd_login "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  version|--version|-V) echo "ai-ta-for-student $(ta_version)" ;;
  -h|--help|help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        safety_first "$@"; launch_claude "$@" ;;
esac
